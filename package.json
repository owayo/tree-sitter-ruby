{
	"name": "tree-sitter-ruby",
	"version": "26.8.100",
	"description": "Ruby grammar for tree-sitter",
	"repository": "https://github.com/tree-sitter/tree-sitter-ruby",
	"license": "MIT",
	"keywords": [
		"incremental",
		"parsing",
		"tree-sitter",
		"ruby"
	],
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"queries/*",
		"src/**"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"tree-sitter-cli": "^0.26.11"
	},
	"scripts": {
		"generate": "tree-sitter generate",
		"lint": "biome check grammar.js",
		"test": "python3 scripts/corpus_test.py",
		"test:unit": "python3 -m unittest discover -s scripts -p 'test_*.py'",
		"parse": "tree-sitter parse"
	}
}
