{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Biome 2.6 から YAML と Markdown も整形の対象になったため、整形してはならないファイルを外す
		// - pnpm-lock.yaml: pnpm が自身の書式で書き出す生成物。整形すると次の更新で全体が差分になる
		// - CLAUDE.md: AGENTS.md へのシンボリックリンク。core.symlinks=false の Windows では
		//   リンク先を書いた通常のファイルになり、末尾に改行を足すとリンク先が壊れる
		"includes": ["**", "!pnpm-lock.yaml", "!CLAUDE.md"]
	},
	"overrides": [
		{
			// tree-sitter の文法定義ファイル (grammar.js) 固有の抑制
			// - noControlCharactersInRegex: Ruby の識別子から制御文字 (\x00-\x1F) を
			//   除外するための正規表現で意図的に使用している
			// - noThenProperty: tree-sitter の文法 DSL で `then` は Ruby の
			//   case/when/if 構文のノード名として必要
			"includes": ["grammar.js"],
			// フォーマッタが正規表現内の \[ を [ に戻してしまい、
			// tree-sitter generate で "unclosed character class" エラーになるため無効化
			"formatter": {
				"enabled": false
			},
			"linter": {
				"rules": {
					"suspicious": {
						"noControlCharactersInRegex": "off",
						"noThenProperty": "off"
					},
					"complexity": {
						// tree-sitter v0.26 の正規表現パーサーは文字クラス内の [ を
						// エスケープしないと "unclosed character class" エラーになる。
						// biome は \[ を不要なエスケープと判定して除去するため無効化
						"noUselessEscapeInRegex": "off"
					}
				}
			}
		}
	]
}
